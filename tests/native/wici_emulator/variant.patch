+void Table::leaveParent(uint32_t nowS, uint32_t holdS) {
+    if (!ready_ || config_.own == config_.root) return;
+    Left* slot = &left_[0];
+    for (Left& left : left_) {
+        if (left.id == parent_) { slot = &left; break; }
+        if (left.untilS < slot->untilS) slot = &left;
+    }
+    *slot = Left{parent_, nowS + holdS};
+    failures_ = 0;
+    setParent(rotation(static_cast<uint8_t>(step(parent_) + 1), nowS), nowS);
