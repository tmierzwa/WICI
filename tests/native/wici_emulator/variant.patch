+// SPDX-License-Identifier: MIT
+// TYLKO EMULATOR: przełączniki rozstrzygnięć z 2026-11-05 (WICI-DEC-009). Ten plik nie należy do firmware;
+// powstaje z tests/native/wici_emulator/variant.patch na kopii kodu. Wszystkie wyłączone to obecny kod.
+#pragma once
+
+namespace wici_variant {
+struct Flags {
+    bool learnRoutes = false;  // drogi w dół z ruchu w górę, ostatnia wygrywa, bez planu
+    bool floodStays = false;   // ramka rozsyłana zostaje rozsyłana poza ostatnim skokiem
+    bool k1FloodKeepsPriority = false;  // ramka z gniazda K1 bez drogi nie liczy się jako K2 przy limicie 25%
+    bool k1RoutedOnly = false;  // przy limicie 25% liczą się tylko czekające ramki K1 ze znaną drogą
+    // Rozsyłanie ramki DOWN tylko od rodzica. 1: planowy albo zapasowy; 2: także bieżący rodzic;
+    // 3: kontrola pułapki: jak 1, ale odrzucona kopia zostaje oznaczona jako widziana.
+    unsigned floodFromParent = 0;
+    // Pomiar w emulatorze. Rodzaj: 0 kopia odrzucona przez regułę; od rodzica: 1 uznana za już widzianą, 2 pełna kolejka.
+    void (*floodCopy)(unsigned kind, unsigned short own, const unsigned char* envelopeHeader) = nullptr;
+    // Pomiar w emulatorze. Rodzaj: 0 ramka jednoadresowa odrzucona przez regułę (other: nadawca), 1 nieudana runda
+    // trzech prób przekaźnika (other: następny skok, recipient: adresat ramki w dół albo 0).
+    void (*hopEvent)(unsigned kind, unsigned short own, unsigned short other, unsigned short recipient) = nullptr;
+    bool stickyRoutes = false; // drogi z ruchu w górę bez „ostatnia wygrywa”: nauka tylko brakującej drogi
+};
+extern Flags flags;
+}  // namespace wici_variant
