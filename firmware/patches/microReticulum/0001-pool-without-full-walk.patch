+			size_t peak_bytes = 0;   // WICI: największa zajętość od startu
 		};
 
 		struct allocator_info {
@@ -192,6 +194,9 @@ namespace RNS { namespace Utilities {
 		};
 
 		static size_t heap_pool_size();
+		// WICI: zajętość i szczyt puli bez przeglądu całej puli.
+		static inline size_t heap_pool_used() { return heap_pool_info.used_bytes; }
