# Local OS and Python state
.DS_Store
__pycache__/
*.py[cod]
.venv/

# KiCad local preferences, locks and automatic backups
*.kicad_prl
*.lck
*-backups/

# Vendor reference material is local, not part of the open project
/hardware/*/reference-private/

/dist/

# PlatformIO build output and local Python environment of the firmware
/firmware/.pio/
/firmware/src/idf_component.yml
/.venv-pio/

# Native simulator build (software/simulator/build.py --native)
/software/simulator/build/

# Archiwa środowisk Pythona pobierane przez software/laptop/build/build_usb.py
/software/laptop/build/cache/

# PlatformIO build output of the hardware tool projects
/hardware/*/.pio/
