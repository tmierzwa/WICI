(version 1)
(rule "R01 copper spacing" (constraint clearance (min 0.2mm)))
(rule "R01 track width" (constraint track_width (min 0.18mm)))
(rule "R01 via diameter" (constraint via_diameter (min 0.6mm)))
(rule "R01 finished hole" (constraint hole_size (min 0.3mm)))
(rule "R01 annular ring" (constraint annular_width (min 0.15mm)))
(rule "R01 copper to edge" (constraint edge_clearance (min 0.5mm)))
