+namespace sx1262 {
+int LinkDriver::diagRssiSettle(int16_t* dbm, uint32_t* us, int n, uint32_t stepUs) {
+    if (!toStandby()) return 0;
+    rxen(true);
+    const uint8_t continuous[3] = {0xFF, 0xFF, 0xFF};
+    const uint32_t t0 = micros();
+    radio_.command(OP_SET_RX, continuous, 3);
+    int k = 0;
+    for (; k < n; ++k) {
+        while (micros() - t0 < k * stepUs) {}
+        uint8_t raw = 0;
+        radio_.read(OP_GET_RSSI_INST, &raw, 1);
+        us[k] = micros() - t0;
+        dbm[k] = (radio_.lastStatus().mode() == MODE_RX) ? rssiDbm(raw) : 999;
+    }
+    startRx(rxVariable_, rxFixedLength_);
+    return k;
+}
+void LinkDriver::diagCadAfterRx(uint32_t n, uint32_t delayMs, uint32_t& frames, uint32_t& free, uint32_t& busy,
+                                uint32_t& busyTwice, uint32_t& error) {
+    for (uint32_t i = 0; i < n; ++i) {
+        startRx(rxVariable_, rxFixedLength_);
+        const uint32_t t0 = millis();
+        uint16_t irq = 0;
+        bool got = false;
+        while (millis() - t0 < 5000 && radio_.readIrq(irq)) {
+            if (irq & IRQ_RX_END) { got = true; break; }
+            delayMicroseconds(200);
+        }
+        radio_.clearIrq(IRQ_ALL);
+        if (!got) break;
+        ++frames;
+        delay(delayMs);
+        toStandby();
+        const radiolink::Cad a = cad();
+        if (a == radiolink::Cad::Free) ++free;
+        else if (a == radiolink::Cad::Busy) {
+            ++busy;
+            toStandby();
+            if (cad() == radiolink::Cad::Busy) ++busyTwice;
+        } else ++error;
+    }
+    startRx(rxVariable_, rxFixedLength_);
+}
+void LinkDriver::diagCad(uint32_t n, uint32_t& free, uint32_t& busy, uint32_t& busyTwice, uint32_t& error) {
+    for (uint32_t i = 0; i < n; ++i) {
+        toStandby();
+        const radiolink::Cad a = cad();
+        if (a == radiolink::Cad::Free) ++free;
+        else if (a == radiolink::Cad::Busy) {
+            ++busy;
+            toStandby();
+            if (cad() == radiolink::Cad::Busy) ++busyTwice;
+        } else ++error;
+    }
+    startRx(rxVariable_, rxFixedLength_);
+}
+}  // namespace sx1262
